# Copy this file to .env and fill values. Do NOT commit real secrets.

# Server
PORT=4000

# MongoDB (example using mongodb+srv)
DB_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/EXE

# JWT
JWT_SECRET_KEY=your_jwt_secret_here
REFRESH_TOKEN=your_refresh_token_here

# SMTP (Gmail App Password example)
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_MAIL=your.email@gmail.com
SMPT_APP_PASS=16_character_app_password_without_spaces

# Cloudinary
CLOUD_NAME=your_cloud_name
API_KEY_CLOUD=your_api_key
API_SECRET=your_api_secret

# OpenAI / other APIs
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com
MODEL_NAME=gpt-4o
